package primera_aplicacion;

public class Cocinero {
	

		private String nombre = "Jose" ; //nombre=Josefa
		private int edad = 32;
		
		public Cocinero (String nombreCocinero, int edadCocinero) {
			
			System.out.println ("Se acaba de crear un cocinero");
			
			nombre = nombreCocinero;
			edad = edadCocinero;
		}
		
		public int hacerMasa(int grHarina, int grAceite, int grAgua) {
			System.out.println (nombre  + "Hace una masa");
			int grMasa=grHarina+grAgua+grAceite;
					return grMasa;
			
			
		}

		public String consultarNombre() {
		return nombre;
		}
	
	
		public int consultarEdad() {
			return edad;
		}
		
		public void establecerNombre (String nuevoNombre) {
			nombre = nuevoNombre;
		}
}


package primera_aplicacion;


public class Aplicacion {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		Cocinero cocinero1 = new Cocinero ("Jose" ,32);
		System.out.println(cocinero1.consultarNombre());
		System.out.println(cocinero1.consultarEdad());
		int masa = cocinero1.hacerMasa(500,300,50);
		
		System.out.println("Se crea una pizza de"+ masa +"gr");

	}

}
